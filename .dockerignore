# ============================================================================
# Global_Policy_Enforcement sync file: .dockerignore
# SOURCE_DIR: /mnt/cache/Global_Policy_Enforcement
# User Script Sync File: /boot/config/plugins/user.scripts/scripts/Global_Policy_Enforcement
# ============================================================================

# 1. Version Control & Ignore Configs
.git/
.gitignore
.dockerignore
.geminiignore
.claudeignore
.antigravityignore
.hermesignore

# 2. Host Scripts & Local Diagnostics (Not needed inside container runtimes)
/create_.env.example.sh
/safe_commit.sh
/auto_migrate_env.sh
/diagnose.sh
/export_safe_env.sh
/volume_mapper.sh
/config_validator.sh
/autostart
/compose_infrastructure_auditor.sh
/example.gather_context.sh
/gather_context.sh
/app_config_validator.sh

# 3. Environment Variables & Credentials (CRITICAL: Never bake into images)
.env
.env.*
env/
env/.env
*.secret
*.token
.certs/
*.pem
*.key
*.crt

# 4. AI Backups, Logs & Local Artifacts
*.log
/$OUTPUT_FILE
/project_name
/system_manifest_&_infrastructure_profile.md
/markdown_output.md
/last_result.json
/started_at
/has_build
/name
/last_cmd.log
/mnt/datapool/backups/

# 5. Python / Node Development Bloat
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
dist/
build/

# 6. OS & Editor Artifacts
.DS_Store
.vscode/
.idea/
*.swp
*.swo