# ============================================================================
#
# Copy this file to .env and replace every example/placeholder value:
#
#   cp .env.example .env
#
# Do not commit .env. It contains credentials and your private network layout.
#
# Documentation-only networks used below:
#   Docker bridge examples: 192.0.2.0/24      (RFC 5737 TEST-NET-1)
#   LAN/macvlan examples:   198.51.100.0/24   (RFC 5737 TEST-NET-2)
#
# Replace these with subnets valid for your own Docker and LAN environment.
# ============================================================================
# ────────────────────────────────────────────────────────────────────────────
# 0. GLOBAL PROXY, SSL & DOMAIN (Caddy / DuckDNS)
# ────────────────────────────────────────────────────────────────────────────
DOMAIN=example.duckdns.org
DUCKDNS_TOKEN=replace_with_your_duckdns_token
CADDY_LETSENCRYPT_EMAIL=admin@example.com

# ────────────────────────────────────────────────────────────────────────────
# 1. SYSTEM & LOCALIZATION
# ────────────────────────────────────────────────────────────────────────────
TZ=America/Chicago
AGENT_PORT=10001

# ────────────────────────────────────────────────────────────────────────────
# 2. INFRASTRUCTURE VERSION CONTROL (PINNED IMAGE TAGS)
# ────────────────────────────────────────────────────────────────────────────
VERSION_POSTGRES=16
VERSION_REDIS=7
VERSION_QDRANT=latest
VERSION_OLLAMA=latest
VERSION_LITELLM=v1.96.2
VERSION_OPEN_WEBUI=main
VERSION_N8N=latest
VERSION_PROMETHEUS=latest
VERSION_CODE_SERVER=latest
VERSION_HERMES=latest

# ────────────────────────────────────────────────────────────────────────────
# 3. INTERNAL BRIDGE IPs (nestworks_docker_bridge_network - 172.70.0.0/16)
# ────────────────────────────────────────────────────────────────────────────
INT_IP_DB_SHARED=192.0.2.155
INT_IP_DB_N8N=192.0.2.150
INT_IP_DB_LITELLM=192.0.2.151
INT_IP_DB_OPEN_WEBUI=192.0.2.153
INT_IP_REDIS=192.0.2.180
INT_IP_QDRANT=192.0.2.152
INT_IP_OLLAMA=192.0.2.161
INT_IP_LITELLM=192.0.2.165
INT_IP_OPEN_WEBUI=192.0.2.162
INT_IP_N8N=192.0.2.160
INT_IP_N8N_RUNNER=192.0.2.166
INT_IP_SYSTEM_AGENT=192.0.2.170
INT_IP_PROMETHEUS=192.0.2.172
INT_IP_MCP_QDRANT=192.0.2.175
INT_IP_MCP_FILESYSTEM=192.0.2.176
INT_IP_MCP_GITHUB=192.0.2.177
INT_IP_HOME_ASSISTANT=198.51.100.14
INT_IP_CODE_SERVER=192.0.2.11
INT_IP_HERMES_AGENT=192.0.2.168
INT_IP_HERMES_WEBUI=192.0.2.169

# ────────────────────────────────────────────────────────────────────────────
# 4. PHYSICAL LAN STATIC IPs (br0 Bridge - 10.70.10.0/24)
# ────────────────────────────────────────────────────────────────────────────
IP_DB_SHARED=198.51.100.155
IP_DB_N8N=198.51.100.150
IP_DB_LITELLM=198.51.100.151
IP_DB_OPEN_WEBUI=198.51.100.153
IP_REDIS=198.51.100.180
IP_QDRANT=198.51.100.152
IP_OLLAMA=198.51.100.161
IP_LITELLM=198.51.100.165
IP_OPEN_WEBUI=198.51.100.162
IP_N8N=198.51.100.160
IP_N8N_RUNNER=198.51.100.166
IP_SYSTEM_AGENT=198.51.100.170
IP_PROMETHEUS=198.51.100.172
IP_MCP_QDRANT=198.51.100.175
IP_MCP_FILESYSTEM=198.51.100.176
IP_MCP_GITHUB=198.51.100.177
IP_HOME_ASSISTANT=198.51.100.14
IP_CODE_SERVER=198.51.100.11
IP_HERMES_AGENT=198.51.100.168
IP_HERMES_WEBUI=198.51.100.169

# ────────────────────────────────────────────────────────────────────────────
# 5. PHYSICAL MAC ADDRESS BINDINGS (br0)
# ────────────────────────────────────────────────────────────────────────────
MAC_DB_SHARED=02:00:00:00:01:55
MAC_DB_N8N=02:00:00:00:01:50
MAC_DB_LITELLM=02:00:00:00:01:51
MAC_DB_OPEN_WEBUI=02:00:00:00:01:53
MAC_REDIS=02:00:00:00:01:80
MAC_QDRANT=02:00:00:00:01:52
MAC_OLLAMA=02:00:00:00:01:61
MAC_LITELLM=02:00:00:00:01:65
MAC_OPEN_WEBUI=02:00:00:00:01:62
MAC_N8N=02:00:00:00:01:60
MAC_N8N_RUNNER=02:00:00:00:01:66
MAC_SYSTEM_AGENT=02:00:00:00:01:70
MAC_PROMETHEUS=02:00:00:00:01:72
MAC_MCP_QDRANT=02:00:00:00:01:75
MAC_MCP_FILESYSTEM=02:00:00:00:01:76
MAC_MCP_GITHUB=02:00:00:00:01:77
MAC_HOME_ASSISTANT=02:00:00:00:01:14
MAC_CODE_SERVER=02:00:00:00:00:11
MAC_HERMES_AGENT=02:00:00:00:01:68
MAC_HERMES_WEBUI=02:00:00:00:01:69

# ────────────────────────────────────────────────────────────────────────────
# 6. INTERNAL SERVICE & AGENT URLs
# ────────────────────────────────────────────────────────────────────────────
OLLAMA_API_BASE=http://192.0.2.161:11434
URL_LITELLM=http://192.0.2.165:4000
URL_QDRANT=http://192.0.2.152:6333
URL_OPEN_WEBUI=http://192.0.2.162:8080
URL_REDIS=redis://192.0.2.180:6379
AGENT_URL=http://192.0.2.170:10001
QDRANT_MCP_URL=http://mcp-qdrant:8000
FILESYSTEM_MCP_URL=http://mcp-filesystem:8000
GITHUB_MCP_URL=http://mcp-github:8000
HOMEASSISTANT_MCP_URL=http://198.51.100.14:8123/api/mcp
N8N_MCP_URL=http://192.0.2.160:5678/mcp-server/http
URL_CODE_SERVER=http://192.0.2.11:8080
URL_HOME_ASSISTANT=http://198.51.100.14:8123
URL_HERMES_AGENT=http://192.0.2.168:8000
URL_HERMES_WEBUI=http://192.0.2.169:3000

# ────────────────────────────────────────────────────────────────────────────
# 7. DATABASE CONFIGURATION & CREDENTIALS
# ────────────────────────────────────────────────────────────────────────────
POSTGRES_SUPERUSER_PASSWORD=replace_with_your_postgres_superuser_password
REDIS_PASSWORD=replace_with_your_redis_password


LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=replace_with_your_litellm_db_password


N8N_DB_USER=n8n
N8N_DB_PASSWORD=replace_with_your_n8n_db_password


OPEN_WEBUI_DB_USER=openwebui
OPEN_WEBUI_DB_PASSWORD=replace_with_your_open_webui_db_password

# ────────────────────────────────────────────────────────────────────────────
# 8. N8N CORE & RUNNER SECURITY
# ────────────────────────────────────────────────────────────────────────────
N8N_HOST=n8n.example.duckdns.org
N8N_WEBHOOK_URL=https://n8n.example.duckdns.org/
N8N_EDITOR_BASE_URL=https://n8n.example.duckdns.org/
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_PROXY_HOPS=1
N8N_CORS_ALLOWED_ORIGINS=http://${INT_IP_OPEN_WEBUI}:8080,https://n8n.example.duckdns.org,http://198.51.100.184:3000,https://caal.example.duckdns.org

N8N_ENCRYPTION_KEY=replace_with_your_n8n_encryption_key
N8N_USER_MANAGEMENT_JWT_SECRET=replace_with_your_n8n_user_management_jwt_secret
N8N_RUNNERS_AUTH_TOKEN=replace_with_your_n8n_runners_auth_token
N8N_API_KEY=replace_with_your_n8n_api_key
INSTANCE_LEVEL_ACCESS_TOKEN_N8N=replace_with_your_instance_level_access_token_n8n

# ────────────────────────────────────────────────────────────────────────────
# 9. AI GATEWAY, KEYS & AUTHENTICATION
# ────────────────────────────────────────────────────────────────────────────
LITELLM_MASTER_KEY=replace_with_your_litellm_master_key
LITELLM_SALT_KEY=replace_with_your_litellm_salt_key
LITELLM_API_VIRTUAL_KEY=replace_with_your_litellm_api_virtual_key
LITELLM_API_VIRTUAL_KEY_SERVICE_ACCOUNT=replace_with_your_litellm_api_virtual_key_service_account
SYSTEM_AGENT_KEY=replace_with_your_system_agent_key
SYSTEM_AGENT_UUID=395d8b98-9849-4a3e-a092-c2517d75410f
NVIDIA_API_KEY=replace_with_your_nvidia_api_key
OPENAI_API_KEY=replace_with_your_openai_api_key
WEBUI_SECRET_KEY=replace_with_your_webui_secret_key
# ────────────────────────────────────────────────────────────────────────────
# 10. MCP TOOL & PROVIDER INTEGRATION TOKENS
# ────────────────────────────────────────────────────────────────────────────
HF_TOKEN=replace_with_your_hf_token
GITHUB_PERSONAL_ACCESS_TOKEN=replace_with_your_github_personal_access_token
BRAVE_API_KEY=replace_with_your_brave_api_key
HA_LONG_LIVED_TOKEN=replace_with_your_ha_long_lived_token
CODE_SERVER_PASSWORD=replace_with_your_code_server_password
CODE_SERVER_SUDO_PASSWORD=replace_with_your_code_server_sudo_password
